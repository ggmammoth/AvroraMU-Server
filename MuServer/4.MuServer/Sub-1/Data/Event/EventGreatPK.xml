<?xml version="1.0" encoding="utf-8"?>
<!-- 
	(*)Config Enable/Disable Event
	- ScoreDie = points deducted when killed
	- ScoreKill = points added when killing an enemy
	- Points used for the Event top ranking
-->
<EventDauTruong Enable ="1" ScoreDie="40" ScoreKill="100">
	<Message>
	<!-- Mess-->
		<Msg Index="0"	Text="[%s] Entrance will close in %d minutes" />
		<Msg Index="1"	Text="[%s] Entrance has closed." />
		<Msg Index="2"	Text="[%s] Will start in %d minutes" />
		<Msg Index="3"	Text="[%s] Started" />
		<Msg Index="4"	Text="[%s] Ended" />
		<Msg Index="5"	Text="[%s] %s Top [%d] has received the reward!!" />
		<Msg Index="6"	Text="[%s] You reached TOP [%d] (%d points)" />
		<Msg Index="7"	Text="You cannot enter the arena" />
		<Msg Index="8"	Text="The arena is currently not open" />
		<Msg Index="9"	Text="Maximum number reached" />
		<Msg Index="10"	Text="You must be at least level %d" />
		<Msg Index="11"	Text="Maximum limit level %d" />
		<Msg Index="12"	Text="You must have at least Master Level %d" />
		<Msg Index="13"	Text="Maximum limit Master Level %d" />
		<Msg Index="14"	Text="You must have at least %d Resets" />
		<Msg Index="15"	Text="Maximum limit %d Resets" />
		<Msg Index="16"	Text="You must have at least %d Master Resets" />
		<Msg Index="17"	Text="Maximum limit %d Master Resets" />
		<Msg Index="18"	Text="This class is not allowed to enter the arena" />
		<Msg Index="19"	Text="" />
		<Msg Index="20"	Text="" />
		<Msg Index="21"	Text="" />
		<Msg Index="22"	Text="" />
		<Msg Index="23"	Text="Event Ended, starting reward distribution!" />
		<Msg Index="24"	Text="[%s] has %d participants!" />
		<Msg Index="25"	Text="[%s] You need Item [x%d %s] to join the event" />
	</Message>	
	<!--
		Event time config
	-->
    <CreateTime>
	    <Load Index="0" Year="-1" Month="-1" Day="-1" DayOfWeek="-1" Hour="23" Minute="51" Second="0" />

	</CreateTime>
	
	<NPC Class="737" Map="0" X="130" Y="127" Dir="3" Name="Life and Death Battle" />	
	
	<!--
	AlarmTime = Notification
	StandTime = Waiting time for the elimination round
	EventTime = Elimination round duration; when time runs out or MaxDeath is reached (-1 means duration-based) the round ends
	CloseTime = Waiting time after the event ends
	-->
	<TypeDauTruong Index="0" Name="GreatPK Event" AlarmTime="5" StandTime="1" EventTime="15" CloseTime="1">
			<!--
			Participation requirements
			-->
			<ConfigItemCheck  EventItemID="6159" EventItemCount="0" WC="0" WP="0" GP="0"/>	
			
			<ConfigClass   DW="1" DK="1" FE="1" MG="1" DL="1" SU="1" RF="1"/>	
			
			<ConfigCheck  MinUser="1" MaxUser="100" MaxDeath="-1" MinLevel="250" MaxLevel="400" MinMLevel="-1" MaxMLevel="-1" MinReset="-1" MaxReset="-1" MinMReset="-1" MaxMReset="-1"/>	
			
			<!--
			 Gate used to move/respawn the character
			 GateEvent = Event Gate Index
			 GateFinal = Gate after the event ends
			-->
			<ConfigGate  GateEvent="389" GateFinal="17"/>	
			<!--
			 Top rewards
				EventItemBag = Receive item via EventItemBag
				Coin - set unused ones to -1 or 0
			-->
			<ConfigRewardTop1  EventItemBag="166"  WC="20000"/>		
			<ConfigRewardTop2  EventItemBag="167"  WC="20000"/>	
			<ConfigRewardTop3  EventItemBag="168"  WC="20000"/>	
			<ConfigRewardTop4  EventItemBag="169"  WC="20000"/>	
			<ConfigRewardTop5  EventItemBag="170"  WC="20000"/>	
	</TypeDauTruong>	
	
</EventDauTruong>